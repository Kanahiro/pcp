{
  "name": "pointcloud-parquet",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@12.1.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm --filter @pointcloud-parquet/browser build && pnpm --filter @pointcloud-parquet/viewer build",
    "benchmark:copc": "pnpm --filter @pointcloud-parquet/browser build && node scripts/benchmark-copc.mjs",
    "dev:viewer": "pnpm --filter @pointcloud-parquet/browser build && pnpm --filter @pointcloud-parquet/viewer dev",
    "serve": "node scripts/range-server.mjs",
    "test": "pnpm --filter @pointcloud-parquet/browser build && pnpm --recursive --if-present test",
    "typecheck": "pnpm --filter @pointcloud-parquet/browser build && pnpm --recursive --if-present typecheck"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "copc": "0.0.9"
  }
}
